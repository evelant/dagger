#!/usr/bin/env bash
# Build the local dev engine/CLI, start dagger-engine.dev, and install a
# dagger-dev wrapper that always targets it.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: hack/install-dev [options]

Build local dev binaries, start the dev engine as dagger-engine.dev, and install
a dagger-dev wrapper into ~/.local/bin.

Options:
  --fresh          Remove the dagger-engine.dev Docker volume before rebuilding.
  --no-restart    Do not remove an existing dagger-engine.dev container first.
  --skip-build    Only install or refresh the dagger-dev wrapper.
  --link PATH     Install the dagger-dev wrapper at PATH.
  -h, --help      Show this help.
EOF
}

die() {
    echo "hack/install-dev: $*" >&2
    exit 1
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/.." && pwd -P)"

container="${_EXPERIMENTAL_DAGGER_DEV_CONTAINER:-dagger-engine.dev}"
volume="$container"
link_path="${DAGGER_DEV_LINK:-$HOME/.local/bin/dagger-dev}"
restart=1
fresh=0
build=1

while [[ $# -gt 0 ]]; do
    case "$1" in
        --fresh)
            fresh=1
            restart=1
            ;;
        --no-restart)
            restart=0
            ;;
        --skip-build)
            build=0
            ;;
        --link)
            shift
            [[ $# -gt 0 ]] || die "--link requires a path"
            link_path="$1"
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
    shift
done

if (( ! build )); then
    restart=0
    fresh=0
fi

if (( restart || fresh || build )); then
    require_cmd docker

    if [[ -z "${DOCKER_HOST:-}" ]]; then
        DOCKER_HOST="$(docker context inspect -f '{{.Endpoints.docker.Host}}')"
        export DOCKER_HOST
    fi
fi

if (( restart )); then
    if docker container inspect "$container" >/dev/null 2>&1; then
        echo "==> Removing existing Docker container: $container"
        docker rm -f "$container" >/dev/null
    fi
fi

if (( fresh )); then
    if docker volume inspect "$volume" >/dev/null 2>&1; then
        echo "==> Removing Docker volume: $volume"
        docker volume rm "$volume" >/dev/null
    fi
fi

if (( build )); then
    require_cmd dagger
    echo "==> Building dev engine and CLI; starting Docker container: $container"
    (
        cd "$repo_root"
        env \
            -u _EXPERIMENTAL_DAGGER_CLI_BIN \
            -u _EXPERIMENTAL_DAGGER_RUNNER_HOST \
            -u _TEST_DAGGER_CLI_LINUX_BIN \
            -u _DAGGER_TESTS_ENGINE_TAR \
            "$script_dir/build"
    )
fi

mkdir -p "$(dirname "$link_path")"

quoted_repo_root="$(printf '%q' "$repo_root")"
quoted_runner_host="$(printf '%q' "docker-container://$container")"
tmp_path="$(mktemp "${link_path}.tmp.XXXXXX")"
cleanup() {
    if [[ -n "${tmp_path:-}" && -e "$tmp_path" ]]; then
        rm -f "$tmp_path"
    fi
}
trap cleanup EXIT

cat > "$tmp_path" <<EOF
#!/usr/bin/env bash
set -euo pipefail

export DAGGER_SRC_ROOT=$quoted_repo_root
export DAGGER_BIN_ROOT="\${DAGGER_BIN_ROOT:-\$DAGGER_SRC_ROOT/bin}"
export _EXPERIMENTAL_DAGGER_CLI_BIN="\${_EXPERIMENTAL_DAGGER_CLI_BIN:-\$DAGGER_BIN_ROOT/dagger}"
if [[ "\$(uname -s)" != "Linux" ]]; then
    export _TEST_DAGGER_CLI_LINUX_BIN="\${_TEST_DAGGER_CLI_LINUX_BIN:-\$DAGGER_BIN_ROOT/dagger-linux}"
fi
export _EXPERIMENTAL_DAGGER_RUNNER_HOST="\${_EXPERIMENTAL_DAGGER_RUNNER_HOST:-$quoted_runner_host}"
export _DAGGER_TESTS_ENGINE_TAR="\${_DAGGER_TESTS_ENGINE_TAR:-\$DAGGER_BIN_ROOT/engine.tar}"
export PATH="\$DAGGER_BIN_ROOT:\$PATH"

exec "\$DAGGER_BIN_ROOT/dagger" "\$@"
EOF

chmod +x "$tmp_path"
mv "$tmp_path" "$link_path"
tmp_path=""

echo "==> Installed dagger-dev wrapper: $link_path"
echo "    Runner host: docker-container://$container"
echo "    Try: $link_path version"
